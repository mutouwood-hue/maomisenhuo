# Private one-file LVGL 9.5 override. Shared managed_components stays read-only.
set(cf_mask_upstream "${CMAKE_CURRENT_LIST_DIR}/../managed_components/lvgl__lvgl/src/draw/sw/lv_draw_sw_mask.c")
file(SHA256 "${cf_mask_upstream}" cf_mask_upstream_sha)
if(NOT cf_mask_upstream_sha STREQUAL "e1f852a16219644ae2d8a08c8bb49865a6f5af1bb3e2115ec3e423de46675c22")
    message(FATAL_ERROR "CatForest mask override requires exact pinned upstream source")
endif()
idf_component_get_property(cf_mask_lib lvgl__lvgl COMPONENT_LIB)
get_target_property(cf_mask_sources ${cf_mask_lib} SOURCES)
set(cf_mask_replaced 0)
set(cf_mask_result "")
foreach(cf_mask_source IN LISTS cf_mask_sources)
    if(cf_mask_source MATCHES "/src/draw/sw/lv_draw_sw_mask\\.c$")
        math(EXPR cf_mask_replaced "${cf_mask_replaced}+1")
        list(APPEND cf_mask_result "${CMAKE_CURRENT_LIST_DIR}/../private/lvgl_mask_pool/lv_draw_sw_mask.c")
    else()
        list(APPEND cf_mask_result "${cf_mask_source}")
    endif()
endforeach()
if(NOT cf_mask_replaced EQUAL 1)
    message(FATAL_ERROR "Expected exactly one LVGL mask translation unit, got ${cf_mask_replaced}")
endif()
set_property(TARGET ${cf_mask_lib} PROPERTY SOURCES "${cf_mask_result}")
target_include_directories(${cf_mask_lib} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../managed_components/lvgl__lvgl/src/draw/sw")
target_link_libraries(${cf_mask_lib} PRIVATE idf::heap idf::esp_hw_support)

