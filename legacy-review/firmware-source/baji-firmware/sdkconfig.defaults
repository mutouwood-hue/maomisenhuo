# Build configuration for the ESP32-S3-Touch-AMOLED-1.75C.
#
# Derived from the vendor's own LVGL example (examples/esp-idf/02_lvgl_demo_v9),
# trimmed of the demo widgets and extended with the Bluetooth settings the
# near-field social layer needs. Notably the panel is a 466x466 CO5300 AMOLED
# driven over QSPI, so PSRAM, the 240 MHz clock and the enlarged data cache are
# all load-bearing for frame rate rather than nice-to-haves.

# ---------------------------------------------------------------- target & flash
CONFIG_IDF_TARGET="esp32s3"

# The vendor example ships with 32 MB, which also settles the "32 MB or 16 MB?"
# question: the module has 32 MB of flash.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---------------------------------------------------------------- PSRAM (8 MB octal)
# The framebuffer and the software rasteriser's scratch live here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ---------------------------------------------------------------- CPU & caches
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---------------------------------------------------------------- FreeRTOS
CONFIG_FREERTOS_HZ=1000

# ---------------------------------------------------------------- LVGL
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
# 15 ms refresh period keeps the compositor out of the renderer's way.
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_USE_SNAPSHOT=y

# LV_ATTRIBUTE_FAST_MEM_USE_IRAM is OFF, and that is load-bearing rather than a
# performance choice. Turning it on makes LVGL place every LV_ATTRIBUTE_FAST_MEM
# function in IRAM -- hundreds of them, across the blend, colour and maths paths --
# which on this target consumes roughly 105 KB of the 341 KB of IRAM (measured; see
# the numbers below) and moves the debug exception handler out of reach:
#
#   _DebugExceptionVector  = 0x40378280      (fixed position in iram0_0_seg + 0x280)
#   xt_debugexception      = 0x4039a4e8      with the option ON   -> 139,880 bytes
#                          = 0x40380be0      with the option OFF  ->  35,168 bytes
#
# The vector reaches its handler with the Xtensa `j` instruction, which encodes a
# PC-relative offset of at most +/-128 KB, so the ON case fails to link:
#
#   xtensa_vectors.S:466:(.DebugExceptionVector.text+0x3):
#       dangerous relocation: j: cannot encode: xt_debugexception
#
# The margin is worth noting: at 139,880 bytes the link fails by about 9 KB. Shaving
# IRAM until it fits would leave a budget that any future addition could silently
# break, so the option is disabled instead. It costs some LVGL blend speed, and the
# frame-rate budget does not depend on it: the compositor is not the bottleneck (see
# docs/frame-budget.md), and the rasteriser's own hot state is placed in internal
# SRAM by components/cat3d rather than through this LVGL switch.
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set

# Fonts.
#
# The specification ships its own four faces in main/ui/fonts/ (badge_f16, badge_f20,
# badge_f24 and the 40 px numeral face badge_n40), generated by lv_font_conv from Noto
# Sans SC Medium with exactly the code points the badge renders. badge_ui.c selects a
# face per element through the generated table's `font` field, so nothing in the
# firmware references lv_font_montserrat_* or lv_font_source_han_sans_sc_* any more.
#
# LVGL's own CJK face and the Montserrat sizes that an earlier version of this UI used
# are therefore OFF: enabling them would ship a second, unused copy of each in the app
# partition. Montserrat 14 stays as LV_FONT_DEFAULT because LVGL requires a default
# font, and it is the fallback for any text drawn without an explicit face.
#
# Two consequences worth stating, because both are load-bearing and neither is obvious
# from a one-line setting. Neither is set below, because both are already the Kconfig
# default; they are written down because a future change that flips either one would be
# silent.
#
#   LV_FONT_FMT_TXT_LARGE must stay OFF (it is off by default -- the option has no
#   `default y` in managed_components/lvgl__lvgl/Kconfig:1081), and the reason is the
#   bitmap index rather than anything about the kerning data. The four faces are
#   generated uncompressed with one `glyph_bitmap` array each (badge_f20.c:24, 0.69 MB
#   of the 0.80 MB the four faces hold in total), and the glyph description struct
#   stores that array's start index in a 20-bit field when the option is off and a
#   32-bit one when it is on (lv_font_fmt_txt.h:29-43). 20 bits addresses exactly 1 MB,
#   so turning the option on would reinterpret every compiled glyph description against
#   the generated source -- garbled text rather than a build error. The bitmap figures
#   are measured; a face regenerated to be larger has to be rechecked here.
#
#   LV_USE_FONT_COMPRESSED must stay ON (LVGL's default, and set explicitly below),
#   because it is what lets a face be stored compressed at all. The four vendored faces
#   are generated uncompressed, so it changes nothing today, but with it off a
#   regenerated compressed face would fail to compile.
#
# Coverage is a property of the literals in this project, not of "having enabled a
# Chinese font": a subset face carries only the glyphs its generator was told to
# include, and a character outside the subset is a blank box on the glass rather than
# an error. tools/check-font-coverage.mjs measures exactly that -- per face, for the
# elements that face actually draws -- and must pass before a release build.
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_USE_FONT_COMPRESSED=y

# LVGL's built-in performance overlay is OFF, deliberately.
#
# The project does want an on-screen frame-rate readout -- the panel makes the frame
# budget a product requirement -- but it already builds its own, and a better one:
# main.c's PERF log line (app_perf_line) prints the working mode, the cat's effective
# redraw rate, the milliseconds its last frame spent rasterising, the pixels its dirty
# rectangle covers and the internal RAM left, once every 5 s. Those are the numbers the
# frame budget is stated in (docs/frame-budget.md), and they come from the renderer
# rather than from a UI widget, so they are measurable without a finger on the glass.
#
# LVGL's overlay would be a second, redundant readout, and an actively harmful one:
# LV_USE_PERF_MONITOR_POS defaults to LV_ALIGN_BOTTOM_RIGHT (see
# managed_components/lvgl__lvgl/src/lv_conf_internal.h -- the fallback when no
# CONFIG_LV_PERF_MONITOR_ALIGN_* choice is set), and the bottom band of this 466x466
# panel is the care-button area, y 390..462. The overlay is drawn on the top layer, so
# it lands on top of those buttons, and the specification's own safe-circle rule leaves
# nowhere on the glass to move it to.
#
# LV_USE_SYSMON stays enabled because the BSP and the LVGL port both build against the
# sysmon component; with both monitors off lv_sysmon.c creates no widget at all, so it
# costs nothing at runtime.
CONFIG_LV_USE_SYSMON=y
# CONFIG_LV_USE_PERF_MONITOR is not set
# CONFIG_LV_USE_MEM_MONITOR is not set

# ---------------------------------------------------------------- Bluetooth (NimBLE)
# NimBLE rather than Bluedroid: this device is a peripheral and an observer, not a
# gateway, and the smaller stack leaves more internal SRAM for the renderer.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=4
