+    const uint32_t bytes=stride*466+LV_DRAW_BUF_ALIGN;
+    if(!slide_pixels[index]) {
+        slide_pixels[index]=heap_caps_aligned_alloc(LV_DRAW_BUF_ALIGN,bytes,MALLOC_CAP_SPIRAM|MALLOC_CAP_8BIT);
