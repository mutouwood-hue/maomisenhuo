 /* Keep the original palette, pixel art, HUD, six care actions and social layouts. */
 [hidden] { display:none !important; }
+/* One live connection panel inside the original daily badge page. */
+#lf-badge-connection { padding:20px 16px; }
+#lf-badge-connection #offline-v2-panel { display:block; }
+.badge-connect-hero { text-align:center; }
+.badge-connect-hero h3 { margin:10px 0; font-size:19px; }
+.badge-connect-hero p { line-height:1.65; }
+.badge-radar { position:relative; isolation:isolate; width:min(210px,60vw); aspect-ratio:1; margin:4px auto 20px; border-radius:50%; background:#f0eadf; overflow:hidden; }
+.badge-radar i { position:absolute; border:1px solid #9daf9770; border-radius:50%; inset:8%; }
+.badge-radar i:nth-child(2) { inset:23%; }
+.badge-radar i:nth-child(3) { inset:38%; }
+.badge-radar span { position:absolute; inset:0; display:grid; place-items:center; color:#6c8d70; font-size:27px; }
+.badge-radar::after { content:''; position:absolute; inset:0; border-radius:inherit; background:conic-gradient(from 0deg,transparent 66%,#86a68540 98%,#73997970); opacity:0; }
+.badge-radar.is-searching::after { opacity:1; animation:badge-search 3s linear infinite; }
+.badge-device-list,.badge-connect-actions { display:flex; flex-direction:column; gap:10px; margin:14px 0; }
+.badge-connect-actions .g-btn,.badge-device-list .g-btn { width:100%; min-height:46px; }
+.lf-badge-privacy { margin-top:16px; border:1px solid #dacdbb; border-radius:16px; overflow:hidden; }
+.lf-badge-privacy summary { cursor:pointer; padding:16px; font-weight:700; min-height:46px; box-sizing:border-box; }
+.lf-badge-privacy>.lf-sec { margin:0; border:0; }
+@keyframes badge-search { to { transform:rotate(360deg); } }
+@media (prefers-reduced-motion:reduce) { .badge-radar.is-searching::after { animation:none; } }
